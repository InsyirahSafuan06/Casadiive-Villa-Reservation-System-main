{
  "name": "Casadive Villa",
  "dataColors": [
    "#FE810A",
    "#2A78D6",
    "#1BAF7A",
    "#E34948",
    "#4A3AA7",
    "#E87BA4",
    "#EDA100",
    "#008300"
  ],
  "background": "#FDFAF4",
  "foreground": "#5B3A29",
  "tableAccent": "#FD590C",
  "good": "#0CA30C",
  "neutral": "#EDA100",
  "bad": "#D03B3B",
  "maximum": "#FD590C",
  "center": "#EDA100",
  "minimum": "#FFF0D3",
  "null": "#C3C2B7",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "color": "#5B3A29",
      "fontSize": 14
    },
    "label": {
      "fontFace": "Segoe UI",
      "color": "#5B3A29",
      "fontSize": 11
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "color": "#FD590C",
      "fontSize": 32
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          { "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }
        ],
        "border": [
          { "show": true, "color": { "solid": { "color": "#F3D9B1" } } }
        ],
        "outspacePane": [
          { "backgroundColor": { "solid": { "color": "#FFF0D3" } } }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          { "color": "#FD590C", "fontSize": 28, "fontFamily": "Segoe UI Semibold" }
        ],
        "categoryLabels": [
          { "color": "#844525", "fontSize": 12, "fontFamily": "Segoe UI" }
        ]
      }
    },
    "pieChart": {
      "*": {
        "legend": [{ "show": true, "position": "Right" }],
        "labels": [{ "show": true, "color": "#5B3A29" }]
      }
    },
    "donutChart": {
      "*": {
        "legend": [{ "show": true, "position": "Right" }],
        "labels": [{ "show": true, "color": "#5B3A29" }]
      }
    },
    "barChart": {
      "*": {
        "labels": [{ "show": true, "color": "#5B3A29" }]
      }
    },
    "columnChart": {
      "*": {
        "labels": [{ "show": true, "color": "#5B3A29" }]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [{ "strokeWidth": 3 }]
      }
    }
  }
}
